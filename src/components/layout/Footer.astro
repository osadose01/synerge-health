---
import BrandMark from "./BrandMark.astro";
---

<footer class="bg-[#060B09] border-t border-[rgba(43,224,176,0.08)] pt-20 pb-10">
  <div class="container mx-auto px-6 sm:px-8 md:px-16">
    <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-5 gap-12 pb-16 border-b border-[rgba(43,224,176,0.06)]">
      <div class="lg:col-span-2 space-y-6">
        <a href="/" class="flex items-center gap-3 group" aria-label="Synerge Health home">
          <span class="inline-flex items-center gap-3 select-none transition-opacity duration-300 group-hover:opacity-75">
            <BrandMark />
            <span class="font-display font-bold tracking-wider text-[#F8FAFC] leading-none text-lg sm:text-xl md:text-2xl">
              SYNERGE <span class="text-[#2BE0B0]">HEALTH</span>
            </span>
          </span>
        </a>
        <p class="text-sm text-[#8FA39A] leading-[1.75] max-w-sm">
          A venture studio working with founders to build healthcare technology for African markets.
        </p>
        <div class="flex items-center gap-3">
          <a
            href="https://linkedin.com/company/synergehealth"
            target="_blank"
            rel="noopener noreferrer"
            aria-label="LinkedIn"
            class="w-9 h-9 rounded-full border border-[rgba(43,224,176,0.15)] bg-[#0D1815] flex items-center justify-center text-[#8FA39A] hover:border-[#2BE0B0] hover:text-[#2BE0B0] transition-all duration-300"
          >
            <svg class="w-3.5 h-3.5 fill-current" viewBox="0 0 24 24" aria-hidden="true">
              <path d="M19 3a2 2 0 0 1 2 2v14a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2V5a2 2 0 0 1 2-2h14m-.5 15.5v-5.3a3.26 3.26 0 0 0-3.26-3.26c-.85 0-1.84.52-2.28 1.3v-1.11h-2.79v8.37h2.79v-4.93c0-.77.62-1.4 1.39-1.4a1.4 1.4 0 0 1 1.4 1.4v4.93h2.75M6.88 8.56a1.68 1.68 0 0 0 1.68-1.68c0-.93-.75-1.69-1.68-1.69a1.69 1.69 0 0 0-1.69 1.69c0 .93.76 1.68 1.69 1.68m1.39 9.94v-8.37H5.5v8.37h2.77z" />
            </svg>
          </a>
          <a
            href="https://x.com/synergehealth"
            target="_blank"
            rel="noopener noreferrer"
            aria-label="X (Twitter)"
            class="w-9 h-9 rounded-full border border-[rgba(43,224,176,0.15)] bg-[#0D1815] flex items-center justify-center text-[#8FA39A] hover:border-[#2BE0B0] hover:text-[#2BE0B0] transition-all duration-300"
          >
            <svg class="w-3.5 h-3.5 fill-current" viewBox="0 0 24 24" aria-hidden="true">
              <path d="M18.244 2.25h3.308l-7.227 8.26 8.502 11.24H16.17l-5.214-6.817L4.99 21.75H1.68l7.73-8.835L1.254 2.25H8.08l4.713 6.231zm-1.161 17.52h1.833L7.084 4.126H5.117z" />
            </svg>
          </a>
        </div>
      </div>

      <div class="space-y-4">
        <p class="font-mono text-[11px] uppercase tracking-[0.2em] text-[#2BE0B0]">Ventures</p>
        <ul class="space-y-2.5 text-sm text-[#8FA39A]">
          <li><a href="/portfolio" class="hover:text-[#F8FAFC] transition-colors">Portfolio Companies</a></li>
          <li><a href="/founders" class="hover:text-[#F8FAFC] transition-colors">Venture Studio Model</a></li>
          <li><a href="/founders#apply" class="hover:text-[#F8FAFC] transition-colors">Apply as Founder</a></li>
          <li><a href="/insights" class="hover:text-[#F8FAFC] transition-colors">Synerge Insights</a></li>
          <li><a href="/investors" class="hover:text-[#F8FAFC] transition-colors">Investor Enquiries</a></li>
        </ul>
      </div>

      <div class="space-y-4">
        <p class="font-mono text-[11px] uppercase tracking-[0.2em] text-[#2BE0B0]">Studio</p>
        <ul class="space-y-2.5 text-sm text-[#8FA39A]">
          <li><a href="/about" class="hover:text-[#F8FAFC] transition-colors">About Us</a></li>
          <li><a href="/services" class="hover:text-[#F8FAFC] transition-colors">Studio Services</a></li>
          <li><a href="/events" class="hover:text-[#F8FAFC] transition-colors">Events</a></li>
          <li><a href="/careers" class="hover:text-[#F8FAFC] transition-colors">Careers</a></li>
          <li><a href="/contact" class="hover:text-[#F8FAFC] transition-colors">Contact</a></li>
        </ul>
      </div>

      <div class="space-y-4">
        <p class="font-mono text-[11px] uppercase tracking-[0.2em] text-[#2BE0B0]">Dispatch</p>
        <p class="text-xs text-[#8FA39A] leading-relaxed">Healthtech, venture building, and studio news.</p>
        <form id="newsletter-form" class="space-y-2">
          <div class="relative">
            <label for="newsletter-email" class="sr-only">Email address</label>
            <input
              id="newsletter-email"
              name="email"
              type="email"
              required
              maxlength="254"
              class="w-full bg-[#0D1815] border border-[rgba(43,224,176,0.15)] rounded-full px-4 py-2.5 text-xs text-[#F8FAFC] focus:border-[#2BE0B0] focus-visible:outline focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-[#5FF5CC] pr-10"
            />
            <button
              type="submit"
              class="absolute right-1 top-1 bottom-1 px-3 rounded-full bg-[#2BE0B0] text-[#060B09] flex items-center justify-center hover:bg-[#5FF5CC] transition-colors disabled:opacity-50"
              aria-label="Subscribe"
            >
              <svg class="w-3.5 h-3.5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                <path d="M5 12h14M12 5l7 7-7 7" />
              </svg>
            </button>
          </div>
          <div class="hidden" aria-hidden="true" style="display:none !important">
            <label for="newsletter-company">Company</label>
            <input
              id="newsletter-company"
              name="company"
              type="text"
              tabindex="-1"
              autocomplete="off"
            />
          </div>
          <div id="newsletter-turnstile" class="pt-1 min-h-[65px]"></div>
          <p id="newsletter-status" class="text-xs" role="status" aria-live="polite"></p>
          <p class="text-[11px] text-[#8FA39A]">Subscribe to Dispatch.</p>
        </form>
      </div>
    </div>

    <div class="pt-8 flex flex-col sm:flex-row items-center justify-between gap-4 text-xs text-[#8FA39A]">
      <p>© {new Date().getFullYear()} Synerge Health. All rights reserved.</p>
      <div class="flex items-center gap-6">
        <a href="/privacy" class="hover:text-[#8FA39A] transition-colors">Privacy Policy</a>
        <a href="/terms" class="hover:text-[#8FA39A] transition-colors">Terms of Service</a>
      </div>
    </div>
  </div>
</footer>

<script>
  const form = document.querySelector<HTMLFormElement>("#newsletter-form");
  const status = document.querySelector<HTMLParagraphElement>("#newsletter-status");
  const email = document.querySelector<HTMLInputElement>("#newsletter-email");
  const company = document.querySelector<HTMLInputElement>("#newsletter-company");
  const submit = form?.querySelector<HTMLButtonElement>('button[type="submit"]');
  const turnstileContainer = document.querySelector<HTMLElement>("#newsletter-turnstile");

  const TURNSTILE_SITE_KEY = "0x4AAAAAAFqP79x5wMwCdAp1";
  let turnstileWidgetId: string | null = null;

  function initTurnstile() {
    const turnstile = (window as unknown as { turnstile?: {
      render: (target: HTMLElement, options: Record<string, unknown>) => string;
      reset: (id?: string) => void;
      getResponse: (id?: string) => string;
    } }).turnstile;

    if (turnstile && turnstileContainer && !turnstileWidgetId) {
      try {
        turnstileWidgetId = turnstile.render(turnstileContainer, {
          sitekey: TURNSTILE_SITE_KEY,
          theme: "dark",
          size: "flexible",
        });
      } catch (err) {
        console.error("Turnstile render failed", err);
      }
    }
  }

  if (typeof window !== "undefined") {
    if ((window as unknown as { turnstile?: unknown }).turnstile) {
      initTurnstile();
    } else {
      const timer = setInterval(() => {
        if ((window as unknown as { turnstile?: unknown }).turnstile) {
          clearInterval(timer);
          initTurnstile();
        }
      }, 150);
      setTimeout(() => clearInterval(timer), 10000);
    }
  }

  form?.addEventListener("submit", async (event) => {
    event.preventDefault();
    if (!email || !status || !submit || !email.reportValidity()) return;

    const turnstile = (window as unknown as { turnstile?: {
      reset: (id?: string) => void;
      getResponse: (id?: string) => string;
    } }).turnstile;

    const turnstileToken = turnstileWidgetId && turnstile
      ? turnstile.getResponse(turnstileWidgetId)
      : "";

    submit.disabled = true;
    status.className = "text-xs text-[#8FA39A]";
    status.textContent = "Subscribing...";

    try {
      const response = await fetch("/api/newsletter", {
        method: "POST",
        headers: { "Content-Type": "application/json" },
        body: JSON.stringify({
          email: email.value,
          company: company?.value ?? "",
          turnstileToken,
        }),
      });
      const payload: unknown = await response.json().catch(() => null);
      const body = payload && typeof payload === "object" && !Array.isArray(payload)
        ? payload as { error?: unknown; message?: unknown }
        : null;
      if (!response.ok) {
        status.className = "text-xs text-red-400";
        status.textContent = typeof body?.error === "string" ? body.error : "Subscription failed. Please try again.";
        return;
      }
      status.className = "text-xs text-[#2BE0B0]";
      status.textContent = body?.message === "This email is already subscribed."
        ? body.message
        : "You’re subscribed.";
      email.value = "";
    } catch {
      status.className = "text-xs text-red-400";
      status.textContent = "Network error. Please try again.";
    } finally {
      submit.disabled = false;
      if (turnstileWidgetId && turnstile) {
        try {
          turnstile.reset(turnstileWidgetId);
        } catch {}
      }
    }
  });
</script>
