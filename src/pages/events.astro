---
import BaseLayout from '@/layouts/BaseLayout.astro';
import { PageHero } from '@/components/layout/PageHero';
---

<BaseLayout
  title="Events & Founder Mixers — Synerge Health"
  description="Contact Synerge Health to ask about upcoming founder sessions and events."
  currentPath="/events"
>
  <main class="flex-1">
    <PageHero
      eyebrow="Events & Network"
      title="Connect with our studio team."
      description="Get in touch to learn about upcoming founder sessions and healthtech events."
    />

    <section class="py-24 bg-[#060B09]">
      <div class="container mx-auto px-6 md:px-12 max-w-4xl">
        <div class="rounded-3xl p-8 md:p-12 bg-[#0D1815] border border-[rgba(43,224,176,0.15)] space-y-5">
          <h2 class="font-display font-bold text-2xl text-[#F2F6F4]">No upcoming events are listed.</h2>
          <p class="text-sm text-[#C2D1CB] leading-relaxed">
            We will share confirmed event details here when they are available. For questions about founder
            sessions or partnerships, contact our team.
          </p>
          <a
            href="/contact"
            class="inline-flex items-center justify-center px-6 py-3 rounded-full border border-[#2BE0B0] text-[#2BE0B0] font-mono text-xs tracking-widest uppercase hover:bg-[#2BE0B0] hover:text-[#060B09] transition-colors"
          >
            Contact the studio
          </a>
        </div>
      </div>
    </section>
  </main>
</BaseLayout>
