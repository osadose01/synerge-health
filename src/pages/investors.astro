---
import BaseLayout from '@/layouts/BaseLayout.astro';
import { PageHero } from '@/components/layout/PageHero';
import { InvestorForm } from '@/components/forms/InvestorForm';

const THESIS_ITEMS = [
  {
    title: "Regulatory planning",
    desc: "We help founders identify the regulatory questions relevant to their product and seek qualified, jurisdiction-specific guidance.",
  },
  {
    title: "Market context",
    desc: "Product and distribution decisions should account for local care workflows, infrastructure, purchasing, and partner needs.",
  },
  {
    title: "Sustainable operations",
    desc: "We examine how a venture can deliver value to patients and providers while developing a viable operating model.",
  },
  {
    title: "Founder collaboration",
    desc: "We work with founders to test assumptions, build products, and plan responsible routes to market.",
  },
];

const APPROACH_AREAS = [
  { title: "Healthtech focus", description: "Our areas span care delivery (virtual care and specialty platforms), health-system infrastructure (records, insurance, supply, and logistics), and clinical intelligence (AI, diagnostics, genomics, and analytics)." },
  { title: "Venture building", description: "Hands-on collaboration with founders from problem exploration through company development." },
  { title: "African markets", description: "We consider local care workflows, regulation, infrastructure, and partnerships in each market." },
];
---

<BaseLayout
  title="Investors & Partners — Synerge Health"
  description="Learn about Synerge Health's approach to building healthcare ventures and connect with the team."
  currentPath="/investors"
>
  <main class="flex-1">
    <PageHero
      eyebrow="Investors & Partners"
      title="Partner with founders building healthtech for African markets."
      description="Synerge invests in ventures and supports founders to raise from external investors."
    />

    <!-- Investment Thesis -->
    <section class="py-28 md:py-40 bg-[#060B09] border-t border-[rgba(43,224,176,0.06)]">
      <div class="container mx-auto px-6 sm:px-8 md:px-16">
        <div class="grid md:grid-cols-[1fr_1.6fr] gap-12 md:gap-24 items-start">
          <h2 class="label-mono">Our approach</h2>
          <div>
            <div class="grid sm:grid-cols-2 gap-0 border border-[rgba(43,224,176,0.12)] rounded-2xl overflow-hidden bg-[#0D1815]">
              {THESIS_ITEMS.map((item, i) => (
                <div
                  class={`p-8 space-y-3 ${
                    i % 2 === 0 ? "border-r border-[rgba(43,224,176,0.12)]" : ""
                  } ${i < 2 ? "border-b border-[rgba(43,224,176,0.12)]" : ""}`}
                >
                  <h3 class="font-display font-semibold text-lg text-[#F2F6F4]">{item.title}</h3>
                  <p class="text-xs text-[#8FA39A] leading-[1.8]">{item.desc}</p>
                </div>
              ))}
            </div>
          </div>
        </div>
      </div>
    </section>

    <!-- Studio approach -->
    <section class="py-28 md:py-40 bg-[#0D1815] border-t border-[rgba(43,224,176,0.06)]">
      <div class="container mx-auto px-6 sm:px-8 md:px-16">
        <div class="grid sm:grid-cols-3 gap-6">
          {APPROACH_AREAS.map((area) => (
            <article class="p-8 rounded-2xl border border-[rgba(43,224,176,0.12)] bg-[#060B09] space-y-3">
              <h2 class="font-display font-semibold text-lg text-[#F2F6F4]">{area.title}</h2>
              <p class="text-sm text-[#8FA39A] leading-relaxed">{area.description}</p>
            </article>
          ))}
        </div>
      </div>
    </section>

    <!-- Investor Inquiry Form -->
    <section class="py-28 md:py-40 bg-[#060B09] border-t border-[rgba(43,224,176,0.06)]">
      <div class="container mx-auto px-6 sm:px-8 md:px-16">
        <div class="max-w-2xl mx-auto text-center mb-16 space-y-4">
          <p class="label-mono">Investor enquiries</p>
          <h2 class="font-display font-bold text-3xl md:text-5xl text-[#F8FAFC]">
            Start a conversation
          </h2>
          <p class="text-sm text-[#C2D1CB]">
            Tell us about your organisation, investment interests, and typical ticket size. We will follow up if there is a relevant opportunity.
          </p>
        </div>

        <div class="max-w-3xl mx-auto">
          <InvestorForm client:load />
        </div>
      </div>
    </section>
  </main>
</BaseLayout>
