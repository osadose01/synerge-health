---
import BaseLayout from '@/layouts/BaseLayout.astro';
import { PageHero } from '@/components/layout/PageHero';
import { InvestorForm } from '@/components/forms/InvestorForm';

const THESIS_ITEMS = [
  {
    title: "Pre-Cleared Compliance",
    desc: "We navigate complex multi-country regulatory pathways—pre-clearing approvals with national health ministries, pharmacy boards, and data protection frameworks (NDPR/POPIA) before seed capital is deployed.",
  },
  {
    title: "Interrelated Ecosystem",
    desc: "Standalone health apps stall at national borders. Our ventures plug directly into established African hospital networks, insurance pools, and informal pharmacy supply chains across regional trade blocs.",
  },
  {
    title: "Out-of-Pocket Realities",
    desc: "Built from day one for out-of-pocket cash payments, mobile money rails, and intermittent bandwidth—guaranteeing cash-flow positivity without relying on Western SaaS assumptions.",
  },
  {
    title: "In-The-Trenches Execution",
    desc: "We pair African clinicians with battle-tested venture builders inside the studio, retaining active operational oversight to protect capital efficiency, patient safety, and scale.",
  },
];

const STATS = [
  { value: "$1M", label: "Initial Venture Fund" },
  { value: "3×", label: "Target 5-Year ROI" },
  { value: "100%", label: "HealthTech Focus" },
];
---

<BaseLayout
  title="Investors & Partners — Synerge Health"
  description="Invest alongside Synerge Health in high-growth African digital health startups."
  currentPath="/investors"
>
  <main class="flex-1">
    <PageHero
      eyebrow="Investors & Partners"
      title="Deploying smart capital into African healthcare infrastructure."
      description="We partner with institutional VCs, DFIs, family offices, and healthcare corporates to syndicate capital into studio-built ventures."
    />

    <!-- Investment Thesis -->
    <section class="py-28 md:py-40 bg-[#060B09] border-t border-[rgba(43,224,176,0.06)]">
      <div class="container mx-auto px-6 sm:px-8 md:px-16">
        <div class="grid md:grid-cols-[1fr_1.6fr] gap-12 md:gap-24 items-start">
          <p class="label-mono">Why Invest</p>
          <div>
            <div class="grid sm:grid-cols-2 gap-0 border border-[rgba(43,224,176,0.12)] rounded-2xl overflow-hidden bg-[#0D1815]">
              {THESIS_ITEMS.map((item, i) => (
                <div
                  class={`p-8 space-y-3 ${
                    i % 2 === 0 ? "border-r border-[rgba(43,224,176,0.12)]" : ""
                  } ${i < 2 ? "border-b border-[rgba(43,224,176,0.12)]" : ""}`}
                >
                  <h3 class="font-display font-semibold text-lg text-[#F2F6F4]">{item.title}</h3>
                  <p class="text-xs text-[#8FA39A] leading-[1.8]">{item.desc}</p>
                </div>
              ))}
            </div>
          </div>
        </div>
      </div>
    </section>

    <!-- Fund Highlights -->
    <section class="py-28 md:py-40 bg-[#0D1815] border-t border-[rgba(43,224,176,0.06)]">
      <div class="container mx-auto px-6 sm:px-8 md:px-16">
        <div class="grid sm:grid-cols-3 gap-6">
          {STATS.map((stat) => (
            <div class="p-8 rounded-2xl border border-[rgba(43,224,176,0.12)] bg-[#060B09] text-center space-y-2">
              <span class="font-display font-bold text-4xl text-[#2BE0B0]">{stat.value}</span>
              <p class="font-mono text-xs uppercase tracking-wider text-[#8FA39A]">{stat.label}</p>
            </div>
          ))}
        </div>
      </div>
    </section>

    <!-- Investor Inquiry Form -->
    <section class="py-28 md:py-40 bg-[#060B09] border-t border-[rgba(43,224,176,0.06)]">
      <div class="container mx-auto px-6 sm:px-8 md:px-16">
        <div class="max-w-2xl mx-auto text-center mb-16 space-y-4">
          <p class="label-mono">Limited Partner Access</p>
          <h2 class="font-display font-bold text-3xl md:text-5xl text-[#F8FAFC]">
            Request LP Data Room
          </h2>
          <p class="text-sm text-[#C2D1CB]">
            Connect with our investment committee to review fund structure and coinvestment pipelines.
          </p>
        </div>

        <div class="max-w-3xl mx-auto">
          <InvestorForm client:load />
        </div>
      </div>
    </section>
  </main>
</BaseLayout>
