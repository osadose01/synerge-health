---
import BaseLayout from '@/layouts/BaseLayout.astro';
import { PageHero } from '@/components/layout/PageHero';
import { ArrowUpRight } from 'lucide-react';
---

<BaseLayout
  title="Portfolio & Cohorts — Synerge Health"
  description="Explore Synerge Health's founding portfolio, studio incubations, and active cohort admissions."
  currentPath="/portfolio"
>
  <main class="flex-1">
    <PageHero
      eyebrow="Portfolio"
      title="Founding ventures powering African health."
      description="Synerge Health continuously co-founds and operates digital health ventures designed around African clinical and market realities."
    />

    <!-- Cohort Status -->
    <section class="py-20 md:py-40 bg-[#060B09] border-t border-[rgba(43,224,176,0.06)]">
      <div class="container mx-auto px-6 sm:px-8 md:px-16">
        <div class="grid md:grid-cols-[1fr_1.6fr] gap-10 md:gap-24 items-start">
          <p class="label-mono">Current Status</p>
          <div>
            <div class="grid sm:grid-cols-3 gap-0 border border-[rgba(43,224,176,0.12)] rounded-2xl overflow-hidden bg-[#0D1815]">
              <div class="p-6 sm:p-8 space-y-4 border-b sm:border-b-0 sm:border-r border-[rgba(43,224,176,0.12)]">
                <p class="label-mono text-[10px]">Cohort 01 — Open</p>
                <h3 class="font-display font-semibold text-base text-[#F2F6F4]">Applications Active</h3>
                <p class="text-xs text-[#8FA39A] leading-relaxed">
                  We are accepting applications from solo founders and early-stage teams. Selected teams undergo a 6-week validation sprint with studio capital.
                </p>
                <a href="/founders#apply" class="inline-flex items-center gap-1.5 font-mono text-xs text-[#2BE0B0] hover:underline pt-2">
                  Apply to Cohort One <ArrowUpRight className="w-3.5 h-3.5" />
                </a>
              </div>

              <div class="p-6 sm:p-8 space-y-4 border-b sm:border-b-0 sm:border-r border-[rgba(43,224,176,0.12)]">
                <p class="label-mono text-[10px]">In-House Incubations</p>
                <h3 class="font-display font-semibold text-base text-[#F2F6F4]">Studio-Built Ventures</h3>
                <p class="text-xs text-[#8FA39A] leading-relaxed">
                  Key ventures originate directly inside the studio, paired with domain experts in pharmacy logistics and AI diagnostic tooling.
                </p>
                <a href="/about" class="inline-flex items-center gap-1.5 font-mono text-xs text-[#2BE0B0] hover:underline pt-2">
                  Our Co-Founding Approach <ArrowUpRight className="w-3.5 h-3.5" />
                </a>
              </div>

              <div class="p-6 sm:p-8 space-y-4">
                <p class="label-mono text-[10px]">Investor Updates</p>
                <h3 class="font-display font-semibold text-base text-[#F2F6F4]">Quarterly Pipeline</h3>
                <p class="text-xs text-[#8FA39A] leading-relaxed">
                  Portfolio announcements, clinical validation metrics, and commercial milestones are shared first with our investor network.
                </p>
                <a href="/investors" class="inline-flex items-center gap-1.5 font-mono text-xs text-[#2BE0B0] hover:underline pt-2">
                  Investor Access <ArrowUpRight className="w-3.5 h-3.5" />
                </a>
              </div>
            </div>
          </div>
        </div>
      </div>
    </section>
  </main>
</BaseLayout>
