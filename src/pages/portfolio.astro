---
import BaseLayout from '@/layouts/BaseLayout.astro';
import { PageHero } from '@/components/layout/PageHero';
import { ArrowUpRight } from 'lucide-react';

const PORTFOLIO_ITEMS = [
  {
    eyebrow: "Portfolio information",
    title: "Portfolio company information",
    description: "We do not publish portfolio company names on this page. Contact us for more information about our venture-building work.",
    href: "/contact",
    link: "Contact the studio",
  },
  {
    eyebrow: "Anonymised example",
    title: "Pharmacy management system",
    description: "Synerge supported venture validation and product development. Company details are withheld for confidentiality.",
    href: "/contact",
    link: "Discuss venture building",
  },
  {
    eyebrow: "Founder applications",
    title: "Share a healthcare problem worth solving.",
    description: "Founders can apply to the Synerge Health Founder Programme. Our team reviews each application for programme fit.",
    href: "/founders#apply",
    link: "Explore the founder programme",
  },
  {
    eyebrow: "Investor enquiries",
    title: "Start a conversation with our team.",
    description: "Investors and partners can contact us to discuss Synerge Health's venture-building approach and current ventures.",
    href: "/investors",
    link: "Investor information",
  },
];
---

<BaseLayout
  title="Portfolio & Founder Programme — Synerge Health"
  description="Learn about Synerge Health's venture-building approach and how founders and investors can connect with the studio."
  currentPath="/portfolio"
>
  <main class="flex-1">
    <PageHero
      eyebrow="Portfolio"
      title="Building healthcare ventures with founders."
      description="We work with founders on healthcare technology designed for the needs and operating realities of their markets."
    />

    <section class="py-20 md:py-40 bg-[#060B09] border-t border-[rgba(43,224,176,0.06)]">
      <div class="container mx-auto px-6 sm:px-8 md:px-16">
        <div class="grid md:grid-cols-[1fr_1.6fr] gap-10 md:gap-24 items-start">
          <p class="label-mono">Portfolio & programme</p>
          <div class="grid sm:grid-cols-2 gap-0 border border-[rgba(43,224,176,0.12)] rounded-2xl overflow-hidden bg-[#0D1815]">
            {PORTFOLIO_ITEMS.map((item, index) => (
              <article class={`p-6 sm:p-8 space-y-4 ${index < 2 ? "border-b border-[rgba(43,224,176,0.12)]" : ""} ${index % 2 === 0 ? "sm:border-r border-[rgba(43,224,176,0.12)]" : ""}`}>
                <p class="label-mono text-[10px]">{item.eyebrow}</p>
                <h2 class="font-display font-semibold text-base text-[#F2F6F4]">{item.title}</h2>
                <p class="text-xs text-[#8FA39A] leading-relaxed">{item.description}</p>
                <a href={item.href} class="inline-flex items-center gap-1.5 font-mono text-xs text-[#2BE0B0] hover:underline pt-2">
                  {item.link} <ArrowUpRight className="w-3.5 h-3.5" />
                </a>
              </article>
            ))}
          </div>
        </div>
      </div>
    </section>
  </main>
</BaseLayout>
