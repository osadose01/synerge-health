---
import BaseLayout from '@/layouts/BaseLayout.astro';
import { PageHero } from '@/components/layout/PageHero';
import { ArrowUpRight } from 'lucide-react';

const SERVICES = [
  {
    id: "strategy",
    num: "01",
    title: "Strategic Guidance",
    summary:
      "Explore business models and clinical workflows in the context of the markets and care settings a venture serves.",
    details: [
      "Customer discovery and market research",
      "Identify regulatory questions and coordinate with qualified advisers",
      "Business model, unit economics, and pricing hypotheses",
      "Research into clinical workflows",
    ],
  },
  {
    id: "operations",
    num: "02",
    title: "Operational Support",
    summary:
      "Practical support with product, team, technology, and operating needs.",
    details: [
      "Technical architecture and security planning",
      "Define roles and support talent searches",
      "Coordinate with qualified legal and intellectual-property advisers",
      "Financial planning and operating processes",
    ],
  },
  {
    id: "funding",
    num: "03",
    title: "Financing & partnerships",
    summary:
      "Support to explore financing options, prepare for investor conversations, and identify relevant partnerships.",
    details: [
      "Financing strategy and investor readiness",
      "Investor outreach and partnership development",
      "Pitch materials and data-room preparation",
      "Coordination with qualified advisers on financing terms",
    ],
  },
];
---

<BaseLayout
  title="Studio Services — Synerge Health"
  description="Explore Synerge Health's work with founders on healthcare venture building."
  currentPath="/services"
>
  <main class="flex-1">
    <PageHero
      eyebrow="Studio Services"
      title="Practical support for healthcare venture building."
      description="Synerge Health works with founders on market research, product and operations, and partnership planning. We agree the scope with each founding team."
    />

    <section class="py-24 md:py-36 bg-[#060B09]">
      <div class="container mx-auto px-6 md:px-12">
        <h2 class="sr-only">Areas of studio support</h2>
        <div class="grid grid-cols-1 md:grid-cols-3 gap-8">
          {SERVICES.map((srv) => (
            <div class="p-8 rounded-2xl border border-[rgba(43,224,176,0.12)] bg-[#0D1815] flex flex-col justify-between space-y-8 group hover:border-[#2BE0B0]/40 transition-colors">
              <div class="space-y-6">
                <span class="font-mono text-xs text-[#2BE0B0] font-semibold">{srv.num}</span>
                <h3 class="font-display font-bold text-2xl text-[#F8FAFC]">{srv.title}</h3>
                <p class="text-sm text-[#C2D1CB] leading-relaxed">{srv.summary}</p>
                <ul class="space-y-2.5 pt-4 border-t border-white/[0.08] text-xs text-[#8FA39A]">
                  {srv.details.map((d) => (
                    <li class="flex items-center gap-2">
                      <span class="w-1.5 h-1.5 rounded-full bg-[#2BE0B0]" />
                      <span>{d}</span>
                    </li>
                  ))}
                </ul>
              </div>

              <a
                href="/founders#apply"
                class="inline-flex items-center gap-1.5 font-mono text-xs text-[#2BE0B0] hover:underline"
              >
                Discuss this area <ArrowUpRight className="w-3.5 h-3.5" />
              </a>
            </div>
          ))}
        </div>
      </div>
    </section>
  </main>
</BaseLayout>
