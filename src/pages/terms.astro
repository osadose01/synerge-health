---
import BaseLayout from '@/layouts/BaseLayout.astro';
import { PageHero } from '@/components/layout/PageHero';
---

<BaseLayout
  title="Terms of Service — Synerge Health"
  description="Terms and conditions governing use of Synerge Health websites and studio resources."
  currentPath="/terms"
>
  <main class="flex-1">
    <PageHero
      eyebrow="Legal & Governance"
      title="Terms of Service"
      description="Last updated: August 2026. Terms governing access to Synerge Health content and venture platforms."
    />

    <section class="py-24 bg-[#060B09]">
      <div class="container mx-auto px-6 md:px-12 max-w-3xl space-y-8 text-sm text-[#C2D1CB] leading-relaxed">
        <h2 class="font-display font-bold text-2xl text-[#F8FAFC]">1. Acceptance of Terms</h2>
        <p>
          By accessing the Synerge Health portal or submitting materials, you agree to these Terms of Service. If you do not agree, please do not use our services.
        </p>

        <h2 class="font-display font-bold text-2xl text-[#F8FAFC]">2. Intellectual Property</h2>
        <p>
          All trademarks, research papers, diagrams, vector graphics, and content published by Synerge Health remain the exclusive property of Synerge Health Ventures.
        </p>

        <h2 class="font-display font-bold text-2xl text-[#F8FAFC]">3. Disclaimer of Investment Advice</h2>
        <p>
          The contents of this site do not constitute an offer to sell or a solicitation of an offer to buy securities. Any investment opportunities are governed strictly by definitive offering documents.
        </p>
      </div>
    </section>
  </main>
</BaseLayout>
