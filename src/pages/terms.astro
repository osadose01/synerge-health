---
import BaseLayout from '@/layouts/BaseLayout.astro';
import { PageHero } from '@/components/layout/PageHero';
---

<BaseLayout
  title="Terms of Service — Synerge Health"
  description="Terms for using the Synerge Health website and submitting information through its forms."
  currentPath="/terms"
>
  <main class="flex-1">
    <PageHero
      eyebrow="Legal & Governance"
      title="Terms of Service"
      description="Last updated: 14 October 2026. Please read these terms before using this website or submitting information."
    />

    <section class="py-24 bg-[#060B09]">
      <div class="container mx-auto px-6 md:px-12 max-w-3xl space-y-5 text-sm text-[#C2D1CB] leading-relaxed">
        <p>
          These terms govern use of this website, operated by Synerge Health Innovation Hub Limited in Nigeria
          (“Synerge Health,” “we,” or “us”).
        </p>

        <h2 class="font-display font-bold text-2xl text-[#F8FAFC]">Use of this website</h2>
        <p>
          You may use this website for lawful purposes and in a way that does not interfere with its operation,
          security, or other users. Do not attempt to gain unauthorized access, disrupt the service, or submit
          malicious or misleading content.
        </p>

        <h2 class="font-display font-bold text-2xl text-[#F8FAFC]">Submissions</h2>
        <p>
          You are responsible for ensuring that information you submit is accurate to the best of your knowledge
          and that you are entitled to share it. Do not submit patient-identifying information, medical records,
          or other sensitive personal information. Do not assume that unsolicited material is confidential or
          that submission creates an advisory, investment, employment, or other relationship.
        </p>
        <p>
          You retain any rights you hold in materials you submit. You permit Synerge Health to review and use
          those materials to respond to your enquiry or assess the opportunity you describe, subject to the
          <a class="text-[#2BE0B0] underline" href="/privacy">Privacy Policy</a>.
        </p>

        <h2 class="font-display font-bold text-2xl text-[#F8FAFC]">Website content and intellectual property</h2>
        <p>
          Unless otherwise stated, website text, branding, and visual materials are owned by or used with
          permission by their respective rights holders. You may view and share links to public pages for
          personal, non-commercial reference. Other reproduction or commercial use requires prior permission
          from the relevant rights holder.
        </p>

        <h2 class="font-display font-bold text-2xl text-[#F8FAFC]">No professional or investment advice</h2>
        <p>
          Website content is general information only; it is not medical, legal, tax, or investment advice.
          Nothing on this website is an offer to sell or a solicitation to buy securities or an investment
          product. Any investment discussion is subject to applicable requirements and definitive written
          documents. Do not make a clinical or investment decision based solely on this website.
        </p>

        <h2 class="font-display font-bold text-2xl text-[#F8FAFC]">No guarantee; external services</h2>
        <p>
          We aim to keep website information useful and current but do not guarantee that it is complete,
          error-free, or continuously available. Links to external websites are provided for convenience; we do
          not control or endorse their content or practices. To the extent permitted by law, the website is
          provided without warranties, and we are not responsible for indirect loss arising from its use.
        </p>

        <h2 class="font-display font-bold text-2xl text-[#F8FAFC]">Changes and contact</h2>
        <p>
          We may update these terms by posting a revised version on this page and changing the date above.
          Please review this page for updates. Questions can be sent to
          <a class="text-[#2BE0B0] underline" href="mailto:hello@synergehealth.com">hello@synergehealth.com</a>.
        </p>
      </div>
    </section>
  </main>
</BaseLayout>
